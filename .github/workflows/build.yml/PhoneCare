name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip project
        run: |
          unzip -o "PhoneCarePro-AndroidStudio-Project.zip" -d project
          ls -R project | head -n 100
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
      - name: Build APK
        run: |
          cd project
          PROJ=$(find . -name "gradlew" | head -n 1 | xargs dirname)
          cd "$PROJ"
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: PhoneCare-APK
          path: "**/app/build/outputs/apk/debug/*.apk"
